<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_priority" model="ir.ui.view">
        <field name="name">res.partner.form.priority</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="priority_level"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_priority" model="ir.ui.view">
        <field name="name">res.partner.tree.priority</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="priority_level" widget="badge" 
                       decoration-info="priority_level == 'low'" 
                   decoration-warning="priority_level == 'medium'" 
                   decoration-danger="priority_level == 'high'"/>
            </xpath>
        </field>
    </record>
 <record id="view_res_partner_filter_priority_final_v1" model="ir.ui.view">
        <field name="name">res.partner.select.priority.final.v1</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="priority_level"/>
                <separator/>
                <filter string="High Priority" name="filter_high_priority" domain="[('priority_level', '=', 'high')]"/>
                <group name="priority_grouping">
                    <filter string="Priority Level" name="groupby_priority" context="{'group_by': 'priority_level'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>